DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary (image uploads for parishes and user profiles)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
JWT_SECRET=your-secret-key-here

# Base URL (used in password-reset emails)
APP_URL=http://localhost:3000
# Optional fallback used when APP_URL is not defined
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo API settings (used for password reset and account verification emails)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com

# Initial admin user credentials created by `prisma db seed`
# Change these before the first deploy, or update via the user profile after login
ADMIN_EMAIL=admin@paroquiaperto.pt
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
