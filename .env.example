DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=your-secret-key-here

# Base URL (used in password-reset emails)
APP_URL=http://localhost:3000

# SMTP settings for sending password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# Brevo API settings (used for password reset and account verification emails)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com

# Initial admin user credentials created by `prisma db seed`
# Change these before the first deploy, or update via the user profile after login
ADMIN_EMAIL=admin@paroquiaperto.pt
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
