{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.sources.organizeImports.excludeFilter": [
        "**/target/generated-sources/**"
    ],
    "java.project.sourcePaths": [
        "backend/src/main/java",
        "backend/target/generated-sources/annotations"
    ],
    "java.project.outputPath": "backend/target/classes",
    "java.project.referencedLibraries": [
        "backend/target/classes/**/*.jar"
    ],
    "files.exclude": {
        "**/target/generated-sources/annotations": false
    },
    "java.debug.settings.enableRunDebugCodeLens": true
}
